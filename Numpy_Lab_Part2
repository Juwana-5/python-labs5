    "import numpy as np\n",
    "\n",
    "A = np.array([[1, 2], [3, 4]])\n",
    "B = np.array([[5, 6], [7, 8]])\n",
    "v = np.array([2, 4])\n",
    "\n",
    "# ضرب عنصري (Element-wise)\n",
    "element_mult = A * B\n",
    "\n",
    "# ضرب مصفوفات (Matrix multiplication)\n",
    "matrix_mult = A @ B\n",
    "\n",
    "# ضرب باستخدام الـ Broadcasting\n",
    "broadcast_mult = A * v\n",
    "\n",
    "print(\"Element-wise:\\n\", element_mult)\n",
    "print(\"Matrix Multi:\\n\", matrix_mult)\n",
    "print(\"Broadcasting A * v:\\n\", broadcast_mult)"
   ]
