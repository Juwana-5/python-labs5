    "# 1. زيادة جميع درجات الفيزياء (العمود الثاني) بمقدار 5\n",
    "scores[:, 1] += 5\n",
    "\n",
    "# 2. استبدال درجات الطالب الأول بـ [100, 100, 100]\n",
    "scores[0, :] = [100, 100, 100]\n",
    "\n",
    "# 3. تعيين العمود الأخير (CS) إلى صفر\n",
    "scores[:, 2] = 0\n",
    "\n",
    "print(\"Updated scores:\\n\", scores)"
