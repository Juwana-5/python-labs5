   "source": [
    "import numpy as np\n",
    "\n",
    "x = np.array([2, 0, 1, 5, 4, 1, 9])\n",
    "A = np.array([[3, 8, 1], [6, 2, 9]])\n",
    "\n",
    "# 1. الحصول على فهارس الترتيب الصاعد وطباعة المصفوفة مرتبة\n",
    "indices = np.argsort(x)\n",
    "print(\"Sorted x using indices:\", x[indices])\n",
    "\n",
    "# 2. إيجاد موقع أقل قيمة في A كـ (صف، عمود)\n",
    "min_loc = np.unravel_index(A.argmin(), A.shape)\n",
    "print(\"Location of minimum value in A:\", min_loc)\n",
    "\n",
    "# 3. الحصول على فهارس القيم الأكبر من 3\n",
    "indices_gt_3 = np.where(x > 3)\n",
    "print(\"Indices where x > 3:\", indices_gt_3)\n",
    "\n",
    "# 4. تقسيم x إلى 3 أجزاء\n",
    "parts = np.split(x, [2, 5])\n",
    "print(\"Split x into parts:\", parts)\n",
    "\n",
    "# 5. تحويل الشكل إلى (1, 7) ثم إعادته إلى (7,)\n",
    "x_expanded = np.expand_dims(x, axis=0)\n",
    "x_squeezed = np.squeeze(x_expanded)\n",
    "print(\"Expanded shape:\", x_expanded.shape)\n",
    "print(\"Squeezed back shape:\", x_squeezed.shape)"
   ]
