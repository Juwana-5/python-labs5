    "import numpy as np\n",
    "\n",
    "# 7. تعريف دوال حساب المسافات (Manhattan & Euclidean)\n",
    "\n",
    "def manhattan_distance(p1, p2):\n",
    "    # حساب مسافة مانهاتن (L1): مجموع الفروق المطلقة بين الإحداثيات\n",
    "    return np.sum(np.abs(p2 - p1))\n",
    "\n",
    "def euclidean_distance(p1, p2):\n",
    "    # حساب المسافة الإقليدية (L2): الجذر التربيعي لمجموع مربعات الفروق\n",
    "    return np.sqrt(np.sum(np.square(p2 - p1)))\n",
    "\n",
    "# تجربة الدوال بنقاط افتراضية (مثلاً نقطة في 1,2 ونقطة في 4,6)\n",
    "point1 = np.array([1, 2])\n",
    "point2 = np.array([4, 6])\n",
    "\n",
    "print(\"Manhattan Distance (L1):\", manhattan_distance(point1, point2))\n",
    "print(\"Euclidean Distance (L2):\", euclidean_distance(point1, point2))"
   ]
  }
